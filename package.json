{
  "name": "fracta",
  "description": "Fracta — one desktop window with Knowledge and Observatory modes",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run check:classes && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:classes",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "svelte-kit sync && vitest run",
    "tauri": "tauri",
    "sidecar": "cd services/fractorches && CGO_ENABLED=1 go build -tags fts5 -o ../../src-tauri/binaries/fractorches ./cmd/agentsview",
    "check:privacy": "bash scripts/check-privacy.sh full",
    "check:privacy:staged": "bash scripts/check-privacy.sh staged",
    "check:classes": "node scripts/check-classes.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@xyflow/svelte": "^1.6.2",
    "dompurify": "^3.3.3",
    "elkjs": "^0.12.0",
    "fractalicons": "^0.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "lucide-svelte": "^0.475.0",
    "mark.js": "^8.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "@types/mark.js": "^8.11.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.4.0",
    "autoprefixer": "^10.4.27",
    "fractalstyler2": "^0.8.0",
    "postcss": "^8.5.8",
    "prettier": "3.9.6",
    "sass": "^1.103.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
